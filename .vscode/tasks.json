{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LRM: Check",
      "type": "shell",
      "command": "pnpm",
      "args": ["check"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "LRM: Build Site",
      "type": "shell",
      "command": "py",
      "args": ["-3", "scripts/build_pages.py"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "LRM: Start Development Server",
      "type": "shell",
      "command": "${workspaceFolder}\\start-server.ps1",
      "args": ["-NoOpen"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
